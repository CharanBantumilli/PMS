generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  legalName            String?
  taxId                String?
  gstin                String?
  sacCode              String?               @default("9961")
  email                String
  phone                String?
  website              String?
  logo                 String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?               @default("IN")
  currency             String                @default("INR")
  timezone             String                @default("UTC")
  locale               String                @default("en")
  checkInTime          String                @default("15:00")
  checkOutTime         String                @default("11:00")
  primaryColor         String?               @default("#0f172a")
  brandName            String?
  maxProperties        Int                   @default(1)
  maxUsers             Int                   @default(5)
  maxUnits             Int                   @default(50)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           ActivityLog[]
  amenityCatalog       Amenity[]
  apiKeys              ApiKey[]
  bookings             Booking[]
  deposits             Deposit[]
  documents            Document[]
  expenses             Expense[]
  extraServices        ExtraService[]
  guests               Guest[]
  staffTasks           HousekeepingTask[]
  integrations         IntegrationConfig[]
  invitations          Invitation[]
  invoices             Invoice[]
  maintenanceTickets   MaintenanceTicket[]
  notes                Note[]
  notifications        Notification[]
  payments             Payment[]
  paymentMethods       PaymentMethodConfig[]
  properties           Property[]
  ratePlans            RatePlan[]
  rateRestrictions     RateRestriction[]
  seasonalRates        SeasonalRate[]
  taxRules             TaxRule[]
  units                Unit[]
  unitTypes            UnitTypeDefinition[]
  users                User[]
  activeSessions       UserSession[]

  @@index([slug])
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String?
  hashedPassword      String?
  image               String?
  emailVerified       DateTime?
  phone               String?
  status              UserStatus          @default(ACTIVE)
  tokenVersion        Int                 @default(0)
  permissions         Json?               // null = role-based defaults, ["bookings","guests",...] = custom
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organizationId      String?
  role                OrganizationRole    @default(MANAGER)
  accounts            Account[]
  activities          ActivityLog[]
  bookings            Booking[]           @relation("BookingCreator")
  housekeeping        HousekeepingTask[]  @relation("TaskAssignee")
  housekeepingCreated HousekeepingTask[]  @relation("TaskCreator")
  sentInvitations     Invitation[]        @relation("InvitationSender")
  maintenance         MaintenanceTicket[] @relation("TicketAssignee")
  maintenanceCreated  MaintenanceTicket[] @relation("TicketCreator")
  sessions            Session[]
  organization        Organization?       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  role           OrganizationRole @default(MANAGER)
  permissions    Json?
  organizationId String
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  senderId       String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User?            @relation("InvitationSender", fields: [senderId], references: [id])

  @@index([organizationId])
  @@index([email])
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           PropertyType
  description    String?
  starRating     Int?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?      @default("US")
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  checkInTime    String?      @default("15:00")
  checkOutTime   String?      @default("11:00")
  policies       String?
  amenities      String[]
  images         String[]
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bookings       Booking[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ratePlans      RatePlan[]
  units          Unit[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model UnitTypeDefinition {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  baseOccupancy  Int          @default(2)
  maxOccupancy   Int          @default(2)
  extraPersonFee Decimal?     @db.Decimal(10, 2)
  size           Float?
  bedType        BedType      @default(QUEEN)
  bedCount       Int          @default(1)
  bathroomCount  Int          @default(1)
  amenities      String[]
  units          Unit[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Unit {
  id              String              @id @default(cuid())
  organizationId  String
  propertyId      String
  unitTypeId      String?
  name            String
  number          String
  floor           String?
  status          UnitStatus          @default(VACANT_CLEAN)
  notes           String?
  images          String[]
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  bookings        Booking[]
  housekeeping    HousekeepingTask[]
  maintenance     MaintenanceTicket[]
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitType        UnitTypeDefinition? @relation(fields: [unitTypeId], references: [id])

  @@unique([propertyId, number])
  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
}

model Amenity {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  icon           String?
  category       String?
  isGlobal       Boolean       @default(false)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model RatePlan {
  id                String            @id @default(cuid())
  organizationId    String
  propertyId        String?
  name              String
  description       String?
  basePrice         Decimal           @db.Decimal(10, 2)
  currency          String            @default("INR")
  isDynamic         Boolean           @default(false)
  weekendMultiplier Decimal?          @db.Decimal(4, 2)
  minStay           Int               @default(1)
  maxStay           Int?
  isRefundable      Boolean           @default(true)
  mealsIncluded     String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookings          Booking[]
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property          Property?         @relation(fields: [propertyId], references: [id])
  rateRestrictions  RateRestriction[]
  seasonalRates     SeasonalRate[]

  @@index([organizationId])
}

model ExtraService {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  price          Decimal        @db.Decimal(10, 2)
  unit           String         @default("per service")
  isActive       Boolean        @default(true)
  bookingItems   BookingExtra[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model TaxRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  rate           Decimal      @db.Decimal(5, 2)
  isInclusive    Boolean      @default(false)
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PaymentMethodConfig {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  type           PaymentMethod
  isActive       Boolean       @default(true)
  instructions   String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Guest {
  id             String       @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  gstin          String?
  idType         String?
  idNumber       String?
  idDocumentUrl  String?
  dateOfBirth    DateTime?
  nationality    String?
  vipLevel       Int          @default(0)
  marketingOptIn Boolean      @default(false)
  notes          String?
  totalStays     Int          @default(0)
  totalSpent     Decimal      @default(0) @db.Decimal(12, 2)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bookings       Booking[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([lastName, firstName])
  @@unique([organizationId, email])
}

model Booking {
  id                 String             @id @default(cuid())
  organizationId     String
  propertyId         String
  unitId             String?
   guestId            String?
  ratePlanId         String?
  createdById        String?
  confirmationCode   String             @unique
  status             BookingStatus      @default(PENDING)
  source             BookingSource      @default(DIRECT)
  arrivalDate        DateTime           @db.Date
  departureDate      DateTime           @db.Date
  nights             Int
  adults             Int                @default(1)
  children           Int                @default(0)
  infants            Int                @default(0)
  pets               Int                @default(0)
  unitRate           Decimal            @db.Decimal(10, 2)
  totalAmount        Decimal            @db.Decimal(12, 2)
  taxAmount          Decimal            @default(0) @db.Decimal(12, 2)
  discount           Decimal            @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal            @default(0) @db.Decimal(12, 2)
  balance            Decimal            @default(0) @db.Decimal(12, 2)
  currency           String             @default("INR")
  specialRequests    String?
  internalNotes      String?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  guestIdType        String?
  guestIdNumber      String?
  idDocumentUrl      String?
  idVerifiedAt       DateTime?
  idVerifiedById     String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          User?              @relation("BookingCreator", fields: [createdById], references: [id])
   guest              Guest?             @relation(fields: [guestId], references: [id], onDelete: SetNull)
   organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
   property           Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ratePlan           RatePlan?          @relation(fields: [ratePlanId], references: [id])
  unit               Unit?              @relation(fields: [unitId], references: [id])
  extras             BookingExtra[]
  housekeeping       HousekeepingTask[]
  maintenance        MaintenanceTicket[]
  invoice            Invoice?
   payments           Payment[]
   deposits           Deposit[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([guestId])
  @@index([arrivalDate, departureDate])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, unitId, status, arrivalDate, departureDate])
}

model BookingExtra {
  id         String       @id @default(cuid())
  bookingId  String
  serviceId  String
  quantity   Int          @default(1)
  unitPrice  Decimal      @db.Decimal(10, 2)
  totalPrice Decimal      @db.Decimal(10, 2)
  notes      String?
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
   service    ExtraService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  bookingId      String?       @unique
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  gstRate        Decimal       @default(0) @db.Decimal(5, 2)
  sacCode        String?       @default("9961")
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  balance        Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String?
  bookingId      String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  paidAt         DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("INR")
  vendor         String?
  receiptUrl     String?
  expenseDate    DateTime        @db.Date
  notes          String?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expenseDate])
  @@index([organizationId, expenseDate])
}

model HousekeepingTask {
  id              String               @id @default(cuid())
  organizationId  String
  propertyId      String
  unitId          String
  bookingId       String?
  type            HousekeepingTaskType @default(FULL_CLEAN)
  status          HousekeepingStatus   @default(PENDING)
  priority        Int                  @default(5)
  assigneeId      String?
  createdById     String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  duration        Int?
  notes           String?
  inspectionNotes String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignee        User?                @relation("TaskAssignee", fields: [assigneeId], references: [id])
  booking         Booking?             @relation(fields: [bookingId], references: [id])
  createdBy       User?                @relation("TaskCreator", fields: [createdById], references: [id])
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit            Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([unitId])
  @@index([status])
  @@index([scheduledFor])
  @@index([organizationId, scheduledFor])
}

model MaintenanceTicket {
  id             String              @id @default(cuid())
  organizationId String
  unitId         String
  bookingId      String?
  title          String
  description    String
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  category       String?
  assigneeId     String?
  createdById    String?
  estimatedCost  Decimal?            @db.Decimal(10, 2)
  actualCost     Decimal?            @db.Decimal(10, 2)
  scheduledFor   DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  assignee       User?               @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy      User?               @relation("TicketCreator", fields: [createdById], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit           Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  booking        Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([unitId])
  @@index([bookingId])
  @@index([organizationId, status])
}

model ActivityLog {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?
  action         ActivityAction
  entity         String
  entityId       String?
  description    String
  metadata       Json?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  url            String
  type           String?
  size           Int?
  uploadedById   String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  content        String
  entityType     String
  entityId       String
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

model SeasonalRate {
  id             String       @id @default(cuid())
  organizationId String
  propertyId     String?
  ratePlanId     String
  name           String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  price          Decimal      @db.Decimal(10, 2)
  currency       String       @default("INR")
  priority       Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
   ratePlan       RatePlan     @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId, startDate, endDate])
}

model RateRestriction {
  id                String       @id @default(cuid())
  organizationId    String
  propertyId        String?
  ratePlanId        String?
  restrictionType   String
  startDate         DateTime     @db.Date
  endDate           DateTime     @db.Date
  daysOfWeek        Int[]        @default([])
  minLOS            Int?
  maxLOS            Int?
  closedToArrival   Boolean      @default(false)
  closedToDeparture Boolean      @default(false)
  minAdvance        Int?
  maxAdvance        Int?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
   ratePlan          RatePlan?    @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([startDate, endDate])
}

model Deposit {
  id             String        @id @default(cuid())
  organizationId String
  bookingId      String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  dueDate        DateTime?     @db.Date
  status         DepositStatus @default(PENDING)
  paymentId      String?
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bookingId])
  @@index([status])
}

model IntegrationConfig {
  id             String          @id @default(cuid())
  organizationId String
  type           IntegrationType
  name           String
  config         Json
  isEnabled      Boolean         @default(true)
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  key            String       @unique
  prefix         String
  scopes         String[]     @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([key])
}

model UserSession {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  sessionToken   String       @unique
  ipAddress      String?
  userAgent      String?
  device         String?
  location       String?
  isActive       Boolean      @default(true)
  lastActiveAt   DateTime     @default(now())
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([organizationId])
}

model Notification {
  id             String               @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  priority       NotificationPriority @default(NORMAL)
  title          String
  message        String
  entity         String?
  entityId       String?
  actionUrl      String?
  metadata       Json?
  isRead         Boolean              @default(false)
  readAt         DateTime?
  createdAt      DateTime             @default(now())
  expiresAt      DateTime?
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([organizationId, type])
}

model NotificationPreference {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  inApp          Boolean          @default(true)
  email          Boolean          @default(false)
  sms            Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  code      String
  purpose   String   // REGISTER, LOGIN, INVITE
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPER
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
